# Admin password for editing portfolio content at /admin
# Use quotes if your password contains special characters like ! # or spaces
ADMIN_PASSWORD="your-secure-password-here"

# Optional: separate secret for signing session cookies (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=another-random-secret-string

# Optional: Upstash Redis for live editing in production (without redeploying)
# Add the Upstash Redis integration from the Vercel Marketplace:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
